package {{ .Package }}

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

// {{ .RowStruct }} is the database representation of {{ .Model }}.
type {{ .RowStruct }} struct {
{{- range .RowFields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .NewRowFunc }} builds the row written by Create and Update.
func {{ .NewRowFunc }}(m *{{ .Model }}) {{ .RowStruct }} {
	return {{ .RowStruct }}{
{{- range .ToRow }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

// toModel converts a scanned row back into the API model.
func (row {{ .RowStruct }}) toModel() {{ .Model }} {
	return {{ .Model }}{
{{- range .ToModel }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

// {{ .Receiver }} stores {{ .Model }} in PostgreSQL.
type {{ .Receiver }} struct {
	db *sqlx.DB
}

// {{ .Constructor }} returns a repository backed by db.
func {{ .Constructor }}(db *sqlx.DB) *{{ .Receiver }} {
	return &{{ .Receiver }}{db: db}
}

func (r *{{ .Receiver }}) Create(ctx context.Context, m *{{ .Model }}) error {
{{- if .GenerateUUID }}
	m.{{ .PKGoName }} = uuid.New()
{{- end }}
{{- if .InsertArgs }}
	row := {{ .NewRowFunc }}(m)
{{- end }}

{{- if .CreateScan }}

	err := r.db.QueryRowContext(ctx,
		`{{ .CreateSQL }}`,
{{- if .InsertArgs }}
		{{ .InsertArgs }},
{{- end }}
	).Scan({{ .CreateScan }})
	if err != nil {
		return fmt.Errorf("create {{ .LowerStruct }}: %w", mapWriteError(err))
	}
{{- else }}

	_, err := r.db.ExecContext(ctx,
		`{{ .CreateSQL }}`,
{{- if .InsertArgs }}
		{{ .InsertArgs }},
{{- end }}
	)
	if err != nil {
		return fmt.Errorf("create {{ .LowerStruct }}: %w", mapWriteError(err))
	}
{{- end }}

	return nil
}

func (r *{{ .Receiver }}) Get(ctx context.Context, id {{ .PKGoType }}) (*{{ .Model }}, error) {
	var row {{ .RowStruct }}

	err := r.db.GetContext(ctx, &row,
		`{{ .GetSQL }}`,
		id,
	)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, {{ .Domain }}.ErrNotFound
		}

		return nil, fmt.Errorf("get {{ .LowerStruct }}: %w", err)
	}

	m := row.toModel()

	return &m, nil
}

func (r *{{ .Receiver }}) List(ctx context.Context, p {{ .ListParams }}) ([]{{ .Model }}, error) {
{{- if .Cursor }}
	order, after := `{{ .ListOrder.Asc }}`, `{{ .ListOrder.AfterAsc }}`
	if p.Dir == {{ .Domain }}.SortDesc {
		order, after = `{{ .ListOrder.Desc }}`, `{{ .ListOrder.AfterDesc }}`
	}
{{- else }}
	order := `{{ .ListOrder.Asc }}`
	if p.Dir == {{ .Domain }}.SortDesc {
		order = `{{ .ListOrder.Desc }}`
	}
{{- end }}
{{- if .ListDynamic }}

	var (
		where []string
		args  []any
	)
{{- range .ListFilters }}

	if p.{{ .GoName }} != nil {
		where = append(where, `{{ .Clause }}`)
		args = append(args, *p.{{ .GoName }})
	}
{{- end }}
{{- if .Cursor }}

	if p.After != nil {
		where = append(where, after)
		args = append(args, {{ .ListOrder.AfterArgs }})
	}
{{- end }}

	q := `{{ .ListSQL }}`
	if len(where) > 0 {
		q += ` WHERE ` + strings.Join(where, ` AND `)
	}

{{- if .Cursor }}

	args = append(args, p.Limit)
	q += ` ORDER BY ` + order + ` LIMIT ?`
{{- else }}

	args = append(args, p.Limit, p.Offset)
	q += ` ORDER BY ` + order + ` LIMIT ? OFFSET ?`
{{- end }}

	var rows []{{ .RowStruct }}

	err := r.db.SelectContext(ctx, &rows,
		r.db.Rebind(q),
		args...,
	)
	if err != nil {
{{- else }}

	q := `{{ .ListSQL }} ORDER BY ` + order + ` LIMIT $1 OFFSET $2`

	var rows []{{ .RowStruct }}

	err := r.db.SelectContext(ctx, &rows,
		q,
		p.Limit, p.Offset,
	)
	if err != nil {
{{- end }}
		return nil, fmt.Errorf("list {{ .LowerStruct }}: %w", err)
	}

	out := make([]{{ .Model }}, len(rows))
	for i := range rows {
		out[i] = rows[i].toModel()
	}

	return out, nil
}

func (r *{{ .Receiver }}) Update(ctx context.Context, m *{{ .Model }}) error {
	row := {{ .NewRowFunc }}(m)

{{- if .UpdateScan }}

	err := r.db.QueryRowContext(ctx,
		`{{ .UpdateSQL }}`,
		{{ .UpdateArgs }},
	).Scan({{ .UpdateScan }})
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return {{ .Domain }}.ErrNotFound
		}

		return fmt.Errorf("update {{ .LowerStruct }}: %w", mapWriteError(err))
	}
{{- else if .NoUpdateColumns }}

	// {{ .Struct }} has no writable columns; verify the row exists.
	var exists int

	err := r.db.GetContext(ctx, &exists,
		`{{ .UpdateSQL }}`,
		{{ .UpdateArgs }},
	)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return {{ .Domain }}.ErrNotFound
		}

		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
{{- else }}

	res, err := r.db.ExecContext(ctx,
		`{{ .UpdateSQL }}`,
		{{ .UpdateArgs }},
	)
	if err != nil {
		return fmt.Errorf("update {{ .LowerStruct }}: %w", mapWriteError(err))
	}

	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}

	if n == 0 {
		return {{ .Domain }}.ErrNotFound
	}
{{- end }}

	return nil
}

func (r *{{ .Receiver }}) Delete(ctx context.Context, id {{ .PKGoType }}) error {
	res, err := r.db.ExecContext(ctx,
		`{{ .DeleteSQL }}`,
		id,
	)
	if err != nil {
		return fmt.Errorf("delete {{ .LowerStruct }}: %w", mapDeleteError(err))
	}

	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("delete {{ .LowerStruct }}: %w", err)
	}

	if n == 0 {
		return {{ .Domain }}.ErrNotFound
	}

	return nil
}
