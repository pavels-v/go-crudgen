package {{ .Package }}

import (
{{- range .Imports }}
	{{ if . }}{{ printf "%q" . }}{{ end }}
{{- end }}
)

// {{ .RowStruct }} is the database representation of {{ .Model }}. Nullable
// columns use sql.Null[T] so a SQL NULL round-trips as an absent value, which
// {{ .NewRowFunc }} and toModel convert to and from the pointer fields on {{ .Model }}.
type {{ .RowStruct }} struct {
{{- range .RowFields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .NewRowFunc }} builds the row written by Create and Update. Generated
// columns are set by the SQL itself, so they are omitted here.
func {{ .NewRowFunc }}(m *{{ .Model }}) {{ .RowStruct }} {
	return {{ .RowStruct }}{
{{- range .ToRow }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

// toModel converts a scanned row back into the API model.
func (row {{ .RowStruct }}) toModel() {{ .Model }} {
	return {{ .Model }}{
{{- range .ToModel }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

// {{ .Receiver }} is a PostgreSQL-backed {{ .Repo }}. It depends on sqlx rather
// than a concrete driver, so any database/sql-compatible Postgres driver
// (lib/pq, pgx's stdlib adapter, ...) can back it.
type {{ .Receiver }} struct {
	db *sqlx.DB
}

// {{ .Constructor }} returns a repository backed by db.
func {{ .Constructor }}(db *sqlx.DB) *{{ .Receiver }} {
	return &{{ .Receiver }}{db: db}
}

var _ {{ .Repo }} = (*{{ .Receiver }})(nil)

func (r *{{ .Receiver }}) Create(ctx context.Context, m *{{ .Model }}) error {
{{- if .GenerateUUID }}
	m.{{ .PKGoName }} = uuid.New()
{{- end }}
	row := {{ .NewRowFunc }}(m)
{{- if .CreateScan }}
	if err := r.db.QueryRowContext(ctx, `{{ .CreateSQL }}`, {{ .InsertArgs }}).Scan({{ .CreateScan }}); err != nil {
		return fmt.Errorf("create {{ .LowerStruct }}: %w", mapWriteError(err))
	}
{{- else }}
	if _, err := r.db.ExecContext(ctx, `{{ .CreateSQL }}`, {{ .InsertArgs }}); err != nil {
		return fmt.Errorf("create {{ .LowerStruct }}: %w", mapWriteError(err))
	}
{{- end }}
	return nil
}

func (r *{{ .Receiver }}) Get(ctx context.Context, id {{ .PKGoType }}) (*{{ .Model }}, error) {
	var row {{ .RowStruct }}
	if err := r.db.GetContext(ctx, &row, `{{ .GetSQL }}`, id); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, {{ .Domain }}.ErrNotFound
		}
		return nil, fmt.Errorf("get {{ .LowerStruct }}: %w", err)
	}
	m := row.toModel()
	return &m, nil
}

func (r *{{ .Receiver }}) List(ctx context.Context, p {{ .ListParams }}) ([]{{ .Model }}, error) {
{{- if .ListFilters }}
	var (
		where []string
		args  []any
	)
{{- range .ListFilters }}
	if p.{{ .GoName }} != nil {
		where = append(where, `{{ .Clause }}`)
		args = append(args, *p.{{ .GoName }})
	}
{{- end }}
{{- else }}
	var args []any
{{- end }}

	desc := p.Dir == {{ .Domain }}.SortDesc
	var order string
	switch {
{{- range .ListSorts }}
	case p.Sort == {{ .Name }} && desc:
		order = `{{ .Desc }}`
	case p.Sort == {{ .Name }}:
		order = `{{ .Asc }}`
{{- end }}
	case desc:
		order = `{{ .ListOrder.Desc }}`
	default:
		order = `{{ .ListOrder.Asc }}`
	}

	q := `{{ .ListSQL }}`
{{- if .ListFilters }}
	if len(where) > 0 {
		q += ` WHERE ` + strings.Join(where, ` AND `)
	}
{{- end }}
	q += ` ORDER BY ` + order + ` LIMIT ? OFFSET ?`
	args = append(args, p.Limit, p.Offset)

	var rows []{{ .RowStruct }}
	if err := r.db.SelectContext(ctx, &rows, r.db.Rebind(q), args...); err != nil {
		return nil, fmt.Errorf("list {{ .LowerStruct }}: %w", err)
	}
	out := make([]{{ .Model }}, len(rows))
	for i := range rows {
		out[i] = rows[i].toModel()
	}
	return out, nil
}

func (r *{{ .Receiver }}) Update(ctx context.Context, m *{{ .Model }}) error {
	row := {{ .NewRowFunc }}(m)
{{- if .UpdateScan }}
	if err := r.db.QueryRowContext(ctx, `{{ .UpdateSQL }}`, {{ .UpdateArgs }}).Scan({{ .UpdateScan }}); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return {{ .Domain }}.ErrNotFound
		}
		return fmt.Errorf("update {{ .LowerStruct }}: %w", mapWriteError(err))
	}
{{- else if .NoUpdateColumns }}
	// {{ .Struct }} has no writable columns; verify the row exists.
	var exists int
	if err := r.db.GetContext(ctx, &exists, `{{ .UpdateSQL }}`, {{ .UpdateArgs }}); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return {{ .Domain }}.ErrNotFound
		}
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
{{- else }}
	res, err := r.db.ExecContext(ctx, `{{ .UpdateSQL }}`, {{ .UpdateArgs }})
	if err != nil {
		return fmt.Errorf("update {{ .LowerStruct }}: %w", mapWriteError(err))
	}
	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
	if n == 0 {
		return {{ .Domain }}.ErrNotFound
	}
{{- end }}
	return nil
}

func (r *{{ .Receiver }}) Delete(ctx context.Context, id {{ .PKGoType }}) error {
	res, err := r.db.ExecContext(ctx, `{{ .DeleteSQL }}`, id)
	if err != nil {
		return fmt.Errorf("delete {{ .LowerStruct }}: %w", mapDeleteError(err))
	}
	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("delete {{ .LowerStruct }}: %w", err)
	}
	if n == 0 {
		return {{ .Domain }}.ErrNotFound
	}
	return nil
}
