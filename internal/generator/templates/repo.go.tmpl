package {{ .Package }}

import (
{{- range .Imports }}
	{{ if . }}{{ printf "%q" . }}{{ end }}
{{- end }}
)

const (
	create{{ .Struct }}SQL = `{{ .CreateSQL }}`
	get{{ .Struct }}SQL    = `{{ .GetSQL }}`
	list{{ .Struct }}SQL   = `{{ .ListSQL }}`
	update{{ .Struct }}SQL = `{{ .UpdateSQL }}`
	delete{{ .Struct }}SQL = `{{ .DeleteSQL }}`
)

// {{ .RowStruct }} is the database representation of {{ .Struct }}. Nullable
// columns use sql.Null[T] so a SQL NULL round-trips as an absent value, which
// {{ .NewRowFunc }} and toModel convert to and from the pointer fields on {{ .Struct }}.
type {{ .RowStruct }} struct {
{{- range .RowFields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .NewRowFunc }} builds the row written by Create and Update. Option-managed
// columns (timestamps) are set by the SQL itself, so they are omitted here.
func {{ .NewRowFunc }}(m *{{ .Struct }}) {{ .RowStruct }} {
	return {{ .RowStruct }}{
{{- range .ToRow }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

// toModel converts a scanned row back into the API model.
func (row {{ .RowStruct }}) toModel() {{ .Struct }} {
	return {{ .Struct }}{
{{- range .ToModel }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

// {{ .Receiver }} is a PostgreSQL-backed {{ .Repo }}. It depends on sqlx rather
// than a concrete driver, so any database/sql-compatible Postgres driver
// (lib/pq, pgx's stdlib adapter, ...) can back it.
type {{ .Receiver }} struct {
	db *sqlx.DB
}

// {{ .Constructor }} returns a {{ .Receiver }} backed by db.
func {{ .Constructor }}(db *sqlx.DB) *{{ .Receiver }} {
	return &{{ .Receiver }}{db: db}
}

var _ {{ .Repo }} = (*{{ .Receiver }})(nil)

func (r *{{ .Receiver }}) Create(ctx context.Context, m *{{ .Struct }}) error {
	row := {{ .NewRowFunc }}(m)
{{- if .HasTimestamps }}
	if err := r.db.QueryRowContext(ctx, create{{ .Struct }}SQL, {{ .InsertArgs }}).Scan({{ .CreateScan }}); err != nil {
		return fmt.Errorf("create {{ .LowerStruct }}: %w", err)
	}
{{- else }}
	if _, err := r.db.ExecContext(ctx, create{{ .Struct }}SQL, {{ .InsertArgs }}); err != nil {
		return fmt.Errorf("create {{ .LowerStruct }}: %w", err)
	}
{{- end }}
	return nil
}

func (r *{{ .Receiver }}) Get(ctx context.Context, id {{ .PKGoType }}) (*{{ .Struct }}, error) {
	var row {{ .RowStruct }}
	if err := r.db.GetContext(ctx, &row, get{{ .Struct }}SQL, id); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, ErrNotFound
		}
		return nil, fmt.Errorf("get {{ .LowerStruct }}: %w", err)
	}
	m := row.toModel()
	return &m, nil
}

func (r *{{ .Receiver }}) List(ctx context.Context, limit, offset int) ([]{{ .Struct }}, error) {
	rows := []{{ .RowStruct }}{}
	if err := r.db.SelectContext(ctx, &rows, list{{ .Struct }}SQL, limit, offset); err != nil {
		return nil, fmt.Errorf("list {{ .LowerStruct }}: %w", err)
	}
	out := make([]{{ .Struct }}, len(rows))
	for i := range rows {
		out[i] = rows[i].toModel()
	}
	return out, nil
}

func (r *{{ .Receiver }}) Update(ctx context.Context, m *{{ .Struct }}) error {
	row := {{ .NewRowFunc }}(m)
{{- if .HasTimestamps }}
	if err := r.db.QueryRowContext(ctx, update{{ .Struct }}SQL, {{ .UpdateArgs }}).Scan({{ .UpdateScan }}); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return ErrNotFound
		}
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
{{- else if .NoUpdateColumns }}
	// {{ .Struct }} has no writable columns; verify the row exists.
	var exists int
	if err := r.db.GetContext(ctx, &exists, update{{ .Struct }}SQL, {{ .UpdateArgs }}); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return ErrNotFound
		}
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
{{- else }}
	res, err := r.db.ExecContext(ctx, update{{ .Struct }}SQL, {{ .UpdateArgs }})
	if err != nil {
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("update {{ .LowerStruct }}: %w", err)
	}
	if n == 0 {
		return ErrNotFound
	}
{{- end }}
	return nil
}

func (r *{{ .Receiver }}) Delete(ctx context.Context, id {{ .PKGoType }}) error {
	res, err := r.db.ExecContext(ctx, delete{{ .Struct }}SQL, id)
	if err != nil {
		return fmt.Errorf("delete {{ .LowerStruct }}: %w", err)
	}
	n, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("delete {{ .LowerStruct }}: %w", err)
	}
	if n == 0 {
		return ErrNotFound
	}
	return nil
}
