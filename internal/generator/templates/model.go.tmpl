package {{ .Package }}
{{- if .Imports }}

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)
{{- end }}

// {{ .Struct }} is the API model of the {{ .Lower }} entity.
type {{ .Struct }} struct {
{{- range .Fields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

{{- if .CursorType }}

type {{ .CursorType }} struct {
{{- range .Cursor }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}
{{- end }}

type {{ .ListParams }} struct {
{{- range .Filters }}
	{{ .GoName }} {{ .GoType }}
{{- end }}
	Dir SortDir
{{- if .CursorType }}
	After *{{ .CursorType }}
{{- end }}
	Limit int
{{- if not .CursorType }}
	Offset int
{{- end }}
}
