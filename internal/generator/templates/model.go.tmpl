package {{ .Package }}

import (
{{- range .Imports }}
	{{ if . }}{{ printf "%q" . }}{{ end }}
{{- end }}
)

// {{ .Struct }} is the API model of the {{ .Lower }} entity.
type {{ .Struct }} struct {
{{- range .Fields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .Repo }} is the storage interface for {{ .Struct }}.
type {{ .Repo }} interface {
	Create(ctx context.Context, m *{{ .Struct }}) error
	Get(ctx context.Context, id {{ .PKGoType }}) (*{{ .Struct }}, error)
	List(ctx context.Context, limit, offset int) ([]{{ .Struct }}, error)
	Update(ctx context.Context, m *{{ .Struct }}) error
	Delete(ctx context.Context, id {{ .PKGoType }}) error
}
