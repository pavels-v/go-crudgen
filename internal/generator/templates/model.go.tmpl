package {{ .Package }}

import (
{{- range .Imports }}
	{{ if . }}{{ printf "%q" . }}{{ end }}
{{- end }}
)

// {{ .Struct }} is the API model of the {{ .Lower }} entity.
type {{ .Struct }} struct {
{{- range .Fields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

{{- if .Sorts }}

type {{ .SortType }} string

const (
{{- range .Sorts }}
	{{ .Name }} {{ $.SortType }} = {{ printf "%q" .Value }}
{{- end }}
)
{{- end }}

{{- if .CursorType }}

type {{ .CursorType }} struct {
{{- range .Cursor }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}
{{- end }}

type {{ .ListParams }} struct {
{{- range .Filters }}
	{{ .GoName }} {{ .GoType }}
{{- end }}
{{- if .Sorts }}
	Sort {{ .SortType }}
{{- end }}
	Dir SortDir
{{- if .CursorType }}
	After *{{ .CursorType }}
{{- end }}
	Limit int
{{- if not .CursorType }}
	Offset int
{{- end }}
}

// {{ .Repo }} is the storage interface for {{ .Struct }}.
type {{ .Repo }} interface {
	Create(ctx context.Context, m *{{ .Struct }}) error
	Get(ctx context.Context, id {{ .PKGoType }}) (*{{ .Struct }}, error)
	List(ctx context.Context, p {{ .ListParams }}) ([]{{ .Struct }}, error)
	Update(ctx context.Context, m *{{ .Struct }}) error
	Delete(ctx context.Context, id {{ .PKGoType }}) error
}
