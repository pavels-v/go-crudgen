package {{ .Package }}
{{ if .Imports }}
import (
{{- range .Imports }}
	{{ if . }}{{ printf "%q" . }}{{ end }}
{{- end }}
)
{{ end }}
// {{ .Struct }} is the API model of the {{ .Lower }} entity.
type {{ .Struct }} struct {
{{- range .Fields }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .CreateName }} is the request body for creating the {{ .Lower }} entity.
type {{ .CreateName }} struct {
{{- range .CreateBody }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .UpdateName }} is the request body for replacing the {{ .Lower }} entity.
type {{ .UpdateName }} struct {
{{- range .UpdateBody }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}
