package {{ .Package }}

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

{{- if .Filters }}

const (
{{- range .Filters }}
	{{ .Const }} = {{ printf "%q" .Name }}
{{- end }}
)
{{- end }}

{{- if .Defaults }}

const (
{{- range .Defaults }}
	{{ .Name }} = {{ .Value }}
{{- end }}
)
{{- end }}

{{- if .Cursor }}

type {{ .Cursor }} struct {
	Dir   {{ .SortDir }} `json:"dir"`
	After {{ .CursorType }} `json:"after"`
}
{{- end }}

// {{ .CreateName }} is the request body for creating the {{ .Lower }} entity.
type {{ .CreateName }} struct {
{{- range .CreateBody }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .UpdateName }} is the request body for replacing the {{ .Lower }} entity.
type {{ .UpdateName }} struct {
{{- range .UpdateBody }}
	{{ .GoName }} {{ .GoType }} `{{ .Tag }}`
{{- end }}
}

// {{ .Struct }}Handler serves the CRUD endpoints for {{ .Struct }}.
type {{ .Struct }}Handler struct {
	repo {{ .Repo }}
}

// New{{ .Struct }}Handler returns a handler backed by repo.
func New{{ .Struct }}Handler(repo {{ .Repo }}) *{{ .Struct }}Handler {
	return &{{ .Struct }}Handler{repo: repo}
}

// Register{{ .Struct }}Routes registers the {{ .Struct }} REST routes on mux.
func Register{{ .Struct }}Routes(mux *http.ServeMux, h *{{ .Struct }}Handler) {
	mux.HandleFunc("POST /{{ .Plural }}", h.Create)
	mux.HandleFunc("GET /{{ .Plural }}", h.List)
	mux.HandleFunc("GET /{{ .Plural }}/{id}", h.Get)
	mux.HandleFunc("PUT /{{ .Plural }}/{id}", h.Update)
	mux.HandleFunc("DELETE /{{ .Plural }}/{id}", h.Delete)
}

func (h *{{ .Struct }}Handler) Create(w http.ResponseWriter, r *http.Request) {
	var req {{ .CreateName }}
	if err := decodeJSON(w, r, &req); err != nil {
		writeDecodeError(w, r, err)
		return
	}

	if err := validate.Struct(req); err != nil {
		writeValidationError(w, r, err)
		return
	}

	m := {{ .Model }}{
{{- range .CreateAssign }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
	if err := h.repo.Create(r.Context(), &m); err != nil {
		writeRepoError(w, r, err)
		return
	}

	writeBody(w, r, http.StatusCreated, m)
}

func (h *{{ .Struct }}Handler) Get(w http.ResponseWriter, r *http.Request) {
	id, ok := pathID(w, r, {{ .PK.Parse }})
	if !ok {
		return
	}

	m, err := h.repo.Get(r.Context(), id)
	if err != nil {
		writeRepoError(w, r, err)
		return
	}

	writeBody(w, r, http.StatusOK, m)
}

func (h *{{ .Struct }}Handler) List(w http.ResponseWriter, r *http.Request) {
	q := newListQuery(r, {{ if .Cursor }}queryCursor{{ else }}queryOffset{{ end }}{{ range .Filters }}, {{ .Const }}{{ end }})
	limit := q.limit()
	p := {{ .ListParams }}{
{{- range .Filters }}
		{{ .GoName }}: queryValue(q, {{ .Const }}, {{ .Parse }}),
{{- end }}
		Dir:    q.dir(),
		Limit:  limit + 1,
{{- if not .Cursor }}
		Offset: q.offset(),
{{- end }}
	}
{{- if .Cursor }}

	if c := queryCursorValue[{{ .Cursor }}](q); c != nil {
		if c.Dir != p.Dir {
			q.invalid(queryCursor)
		}

		p.After = &c.After
	}
{{- end }}

	if q.details != nil {
		writeError(w, r, http.StatusBadRequest, codeInvalidQuery, "invalid query parameters", q.details...)
		return
	}

	items, err := h.repo.List(r.Context(), p)
	if err != nil {
		writeRepoError(w, r, err)
		return
	}

	items, more := trimPage(items, limit)
{{- if .Cursor }}
	page := cursorPage[{{ .Model }}]{Items: items}

	if more {
		last := items[len(items)-1]
		c := {{ .Cursor }}{
			Dir: p.Dir,
			After: {{ .CursorType }}{
{{- range .CursorFields }}
				{{ . }}: last.{{ . }},
{{- end }}
			},
		}

		if page.NextCursor, err = encodeCursor(c); err != nil {
			writeInternalError(w, r, err)
			return
		}
	}

	writeBody(w, r, http.StatusOK, page)
{{- else }}
	writeBody(w, r, http.StatusOK, offsetPage[{{ .Model }}]{Items: items, Limit: limit, Offset: p.Offset, HasMore: more})
{{- end }}
}

func (h *{{ .Struct }}Handler) Update(w http.ResponseWriter, r *http.Request) {
	id, ok := pathID(w, r, {{ .PK.Parse }})
	if !ok {
		return
	}

	var req {{ .UpdateName }}
	if err := decodeJSON(w, r, &req); err != nil {
		writeDecodeError(w, r, err)
		return
	}

	if err := validate.Struct(req); err != nil {
		writeValidationError(w, r, err)
		return
	}

	m := {{ .Model }}{
		{{ .PK.GoName }}: id,
{{- range .UpdateAssign }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
	if err := h.repo.Update(r.Context(), &m); err != nil {
		writeRepoError(w, r, err)
		return
	}

	writeBody(w, r, http.StatusOK, m)
}

func (h *{{ .Struct }}Handler) Delete(w http.ResponseWriter, r *http.Request) {
	id, ok := pathID(w, r, {{ .PK.Parse }})
	if !ok {
		return
	}

	if err := h.repo.Delete(r.Context(), id); err != nil {
		writeRepoError(w, r, err)
		return
	}

	w.WriteHeader(http.StatusNoContent)
}
