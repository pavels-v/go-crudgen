func Test{{ .Struct }}Handler_Create(t *testing.T) {
	t.Parallel()

	valid, err := json.Marshal(validCreate{{ .Struct }}Request())
	require.NoError(t, err)

	cases := []struct {
		name       string
		body       string
		wantStatus int
	}{
		{name: "valid", body: string(valid), wantStatus: http.StatusCreated},
		{name: "malformed body", body: "{", wantStatus: http.StatusBadRequest},
		{name: "unknown field", body: `{"unknown_field":1}`, wantStatus: http.StatusBadRequest},
{{- if .HasRequired }}
		{name: "missing required fields", body: "{}", wantStatus: http.StatusUnprocessableEntity},
{{- end }}
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			h, _ := new{{ .Struct }}TestHandler()

			rec := serve(t, h, http.MethodPost, "/{{ .Plural }}", tc.body)
			require.Equal(t, tc.wantStatus, rec.Code, rec.Body.String())
		})
	}
}

func Test{{ .Struct }}Handler_Get(t *testing.T) {
	t.Parallel()

	h, repo := new{{ .Struct }}TestHandler()
	seeded := seed{{ .Struct }}(t, repo)

	cases := []struct {
		name       string
		id         string
		wantStatus int
	}{
		{name: "existing", id: {{ .SeededID }}, wantStatus: http.StatusOK},
		{name: "missing", id: {{ .MissingID }}, wantStatus: http.StatusNotFound},
{{- if .ParsedKey }}
		{name: "invalid id", id: "not-an-id", wantStatus: http.StatusBadRequest},
{{- end }}
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()

			rec := serve(t, h, http.MethodGet, "/{{ .Plural }}/"+tc.id, "")
			require.Equal(t, tc.wantStatus, rec.Code, rec.Body.String())
		})
	}
}

func Test{{ .Struct }}Handler_List(t *testing.T) {
	t.Parallel()

	h, repo := new{{ .Struct }}TestHandler()
	seed{{ .Struct }}(t, repo)

	rec := serve(t, h, http.MethodGet, "/{{ .Plural }}", "")
	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())

	var page struct {
		Body struct {
			Items []jsontext.Value `json:"items"`
		} `json:"body"`
	}

	require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &page))
	require.Len(t, page.Body.Items, 1)

	rec = serve(t, h, http.MethodGet, "/{{ .Plural }}?limit=0", "")
	require.Equal(t, http.StatusBadRequest, rec.Code, rec.Body.String())
}

