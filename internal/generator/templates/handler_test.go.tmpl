	return Create{{ .Struct }}Request{
{{- range .CreateFixture }}
		{{ .Field }}: {{ .Expr }},
{{- end }}
	}
}

func validUpdate{{ .Struct }}Request() Update{{ .Struct }}Request {
	return Update{{ .Struct }}Request{
{{- range .UpdateFixture }}
