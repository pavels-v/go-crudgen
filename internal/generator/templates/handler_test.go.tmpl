func new{{ .Struct }}TestHandler() (http.Handler, *fakeRepository[{{ .KeyType }}, {{ .Model }}, {{ .ListParams }}]) {
{{- if .GenInt }}
	var seq {{ .KeyType }}

	repo := newFakeRepository[{{ .KeyType }}, {{ .Model }}, {{ .ListParams }}](func(m *{{ .Model }}) *{{ .KeyType }} { return &m.{{ .PKGoName }} }, func() {{ .KeyType }} {
		seq++

		return seq
	})
{{- else if .GenUUID }}
	repo := newFakeRepository[{{ .KeyType }}, {{ .Model }}, {{ .ListParams }}](func(m *{{ .Model }}) *{{ .KeyType }} { return &m.{{ .PKGoName }} }, uuid.New)
{{- else }}
	repo := newFakeRepository[{{ .KeyType }}, {{ .Model }}, {{ .ListParams }}](func(m *{{ .Model }}) *{{ .KeyType }} { return &m.{{ .PKGoName }} }, nil)
{{- end }}
	mux := http.NewServeMux()
	New{{ .Struct }}Handler(repo).RegisterRoutes(mux)

	return WithRouteErrors(mux), repo
}

func seed{{ .Struct }}(t *testing.T, repo *fakeRepository[{{ .KeyType }}, {{ .Model }}, {{ .ListParams }}]) {{ .Model }} {
	t.Helper()

	m := {{ .Model }}{ {{- if .SeedKey }}{{ .PKGoName }}: {{ .SeedKey }}{{ end -}} }
	require.NoError(t, repo.Create(t.Context(), &m))

	return m
}

